package components

import (
	"strconv"
	"workshop/internal/domain/sighting"
)

templ Globe(sightings []sighting.Sighting, sum sighting.Summary, countries []sighting.Tally) {
	<section class="cartography-section container" aria-labelledby="globe-title">
		<div class="cartography-grid" data-stamp-trigger="globe_explorer">
			<div class="cartography-grid__map">
				<div class="globe__instrument">
					<div class="globe__corner globe__corner--tl">LAT // 01°17′S</div>
					<div class="globe__corner globe__corner--tr">LON // 036°49′E</div>
					<div class="globe__corner globe__corner--bl">SCALE // 1 : 42,000,000</div>
					<div class="globe__corner globe__corner--br">EPOCH // J2026.8</div>

					<div class="globe__stage">
						<svg class="globe__astrolabe" viewBox="0 0 400 400" aria-hidden="true">
							<circle cx="200" cy="200" r="192" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35"/>
							<circle cx="200" cy="200" r="184" fill="none" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 6" opacity="0.45"/>
							<circle cx="200" cy="200" r="168" fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.22"/>
							<line x1="200" y1="4" x2="200" y2="22" stroke="currentColor" stroke-width="1.2" opacity="0.5"/>
							<line x1="200" y1="378" x2="200" y2="396" stroke="currentColor" stroke-width="1.2" opacity="0.5"/>
							<line x1="4" y1="200" x2="22" y2="200" stroke="currentColor" stroke-width="1.2" opacity="0.5"/>
							<line x1="378" y1="200" x2="396" y2="200" stroke="currentColor" stroke-width="1.2" opacity="0.5"/>
							<text x="200" y="15" text-anchor="middle" class="globe__astrolabe-text">000° N · MERIDIAN</text>
							<text x="200" y="392" text-anchor="middle" class="globe__astrolabe-text">180° S · NADIR</text>
							<text x="385" y="196" text-anchor="end" class="globe__astrolabe-text">090° E</text>
							<text x="15" y="196" text-anchor="start" class="globe__astrolabe-text">270° W</text>
						</svg>
						@ThreeScene(ThreeSceneProps{Scene: "globe", Label: "An interactive 3D cartographic armillary globe showing the African continent, latitude/longitude graticules, and glowing wildlife sightings by solar hour"})
					</div>
				</div>
				<p class="cartography-grid__caption">FIG. II — ARMILLARY SPHERE OF { strconv.Itoa(sum.Sightings) } SIGHTINGS · DRAG HORIZONTALLY TO ROTATE</p>
			</div>

			<div class="cartography-grid__index reveal">
				<p class="section-num">SECTION 02 // CARTOGRAPHIC DISTRIBUTION</p>
				<h2 id="globe-title" class="display">{ strconv.Itoa(sum.Countries) } territories plotted across the meridian</h2>
				<p class="lede">
					Every coordinate on the sphere is illuminated by the solar hour of the sighting. Select any territory in the surveyor’s table below to isolate its field plates.
				</p>
				@LightLegend()
				if len(countries) > 0 {
					<ol class="cartography-table" aria-label="Top territories by sighting count">
						for i, c := range countries {
							<li>
								<button type="button" class="cartography-table__row" data-country-jump={ c.Name }>
									<span class="cartography-table__idx">0{ strconv.Itoa(i + 1) }</span>
									<span class="cartography-table__name">{ c.Name }</span>
									<span class="cartography-table__dots" aria-hidden="true"></span>
									<strong class="cartography-table__count">{ strconv.Itoa(c.Count) } PLATES ↗</strong>
								</button>
							</li>
						}
					</ol>
				}
			</div>
			@templ.JSONScript("globe-points", GlobePoints(sightings))
		</div>
	</section>
}

templ LightLegend() {
	<ul class="legend" aria-label="Solar phase colour key">
		<li class="legend__item tone--dawn"><span class="legend__swatch"></span>05–08h Alfajiri (Dawn)</li>
		<li class="legend__item tone--day"><span class="legend__swatch"></span>08–16h Mchana (Day)</li>
		<li class="legend__item tone--dusk"><span class="legend__swatch"></span>16–20h Machweo (Dusk)</li>
		<li class="legend__item tone--night"><span class="legend__swatch"></span>20–05h Usiku (Night)</li>
	</ul>
}
