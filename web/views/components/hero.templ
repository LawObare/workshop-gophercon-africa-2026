package components

import (
	"fmt"
	"strconv"
	"workshop/pkg/domain/sighting"
)

templ Hero(banner []sighting.Sighting, sum sighting.Summary) {
	<section class="monograph-hero" data-hero aria-label="Featured field encounters">
		@FlockOfBirds()

		<!-- Architectural Masthead Row: Giant Display + Live Telemetry Ledger -->
		<div class="monograph-hero__masthead container">
			<div class="monograph-hero__headline">
				<p class="monograph-hero__issue">VOL. XXVI · NAIROBI &amp; SAVANNA FIELD SURVEY · ISSUE NO. 1016</p>
				<h1 class="monograph-hero__title">
					Notes from the <em>living bush</em>, indexed by the angle of the sun.
				</h1>
			</div>
			<div class="monograph-hero__colophon">
				<p class="monograph-hero__lede">
					An unvarnished field log of { strconv.Itoa(sum.Sightings) } wild animal encounters across { strconv.Itoa(sum.Countries) } countries. Every photographic plate is cross-referenced with its exact GPS meridian, wind bearing, and atmospheric light.
				</p>
				<dl class="monograph-ledger" aria-label="Survey totals">
					<div>
						<dt>SPECIMENS</dt>
						<dd>{ strconv.Itoa(sum.Sightings) }</dd>
					</div>
					<div>
						<dt>TAXA</dt>
						<dd>{ strconv.Itoa(sum.Species) }</dd>
					</div>
					<div>
						<dt>TERRITORIES</dt>
						<dd>{ strconv.Itoa(sum.Countries) }</dd>
					</div>
					<div>
						<dt>NEGATIVES</dt>
						<dd>{ strconv.Itoa(sum.Media) }</dd>
					</div>
				</dl>
			</div>
		</div>

		<!-- Full-Bleed 35mm Contact Sheet & Field Plate Stage (Zero Rounded Cards) -->
		<div class="monograph-stage container">
			<div class="monograph-stage__viewport">
				for i, s := range banner {
					{{ c, _ := cover(s) }}
					<article class={ "hero__slide", "plate-spread", tones(s), templ.KV("is-active", i == 0) } style={ Morph(s) }>
						<div class="plate-spread__image-col">
							<div class="plate-spread__sprocket" aria-hidden="true">
								<span>KODAK / ILFORD FIELD STOCK · EXP-{ fmt.Sprintf("%03d", s.GBIFKey%1000) }</span>
								<span>FRAME 0{ strconv.Itoa(i + 1) }A</span>
							</div>
							<a class="plate-spread__photo" href={ templ.URL(SightingURL(s)) }>
								<img
									src={ sized(c.URL, "large") }
									srcset={ heroSrcset(c.URL) }
									sizes="(max-width: 900px) 96vw, 68vw"
									alt={ photoAlt(s, c) }
									if i == 0 {
										fetchpriority="high"
									} else {
										loading="lazy"
									}
									decoding="async"
								/>
								<div class="plate-spread__crosshair" aria-hidden="true"></div>
								<span class="plate-spread__open">OPEN DOSSIER [↗]</span>
							</a>
						</div>

						<div class="plate-spread__notes-col">
							<div class="plate-spread__stamp">
								<span class="plate-spread__stamp-country">{ Postmark(s) }</span>
								<span class="plate-spread__stamp-coords">{ ShortCoords(s) }</span>
							</div>

							<div class="plate-spread__taxonomy">
								<span class="plate-spread__fig">PLATE 0{ strconv.Itoa(i + 1) } / 0{ strconv.Itoa(len(banner)) }</span>
								<h2 class="plate-spread__species">
									<a href={ templ.URL(SightingURL(s)) }>{ displayName(s.Species) }</a>
								</h2>
								if s.Species.ScientificName != "" {
									<p class="plate-spread__latin">{ s.Species.ScientificName }</p>
								}
							</div>

							<dl class="plate-spread__specs">
								<div>
									<dt>SOLAR PHASE</dt>
									<dd><span class="plate-spread__dot"></span>{ Light(s) }</dd>
								</div>
								<div>
									<dt>LOCALITY</dt>
									<dd>{ place(s.Location) }</dd>
								</div>
								<div>
									<dt>RECORDED</dt>
									<dd>{ when(s) }</dd>
								</div>
								if TempPill(s) != "" {
									<div>
										<dt>ATMOSPHERE</dt>
										<dd>{ TempPill(s) }</dd>
									</div>
								}
								<div>
									<dt>OBSERVER</dt>
									<dd>
										if s.RecordedBy != "" {
											{ s.RecordedBy }
										} else {
											GBIF Expedition Survey
										}
									</dd>
								</div>
							</dl>

							<div class="plate-spread__cta-row">
								<a class="editorial-link" href={ templ.URL(SightingURL(s)) }>Read full specimen sheet →</a>
								<a class="editorial-link editorial-link--muted" href="/spot">Test in Bushcraft Lab →</a>
							</div>
						</div>
					</article>
				}
			</div>

			<!-- Architectural Contact Strip Index Bar -->
			if len(banner) > 0 {
				<div class="contact-strip">
					<div class="contact-strip__counter">
						<span>ACTIVE PLATE</span>
						<strong data-hero-index>01</strong>
						<span>/ 0{ strconv.Itoa(len(banner)) }</span>
					</div>
					<ol class="hero__captions contact-strip__list">
						for i, s := range banner {
							<li class={ "hero__cap", templ.KV("is-active", i == 0) }>
								<a href={ templ.URL(SightingURL(s)) }>
									<span class="contact-strip__num">0{ strconv.Itoa(i + 1) }</span>
									<span class="contact-strip__name">{ displayName(s.Species) }</span>
									<small class="contact-strip__loc">{ Postmark(s) }</small>
								</a>
							</li>
						}
					</ol>
					if len(banner) > 1 {
						<div class="hero__controls contact-strip__controls">
							<button type="button" class="btn-ctrl press" data-hero-prev aria-label="Previous plate">←</button>
							<button type="button" class="btn-ctrl press" data-hero-pause aria-label="Pause reel" aria-pressed="false">
								<span class="icon-pause">II</span>
								<span class="icon-play">▶</span>
							</button>
							<button type="button" class="btn-ctrl press" data-hero-next aria-label="Next plate">→</button>
						</div>
					}
				</div>
			}
		</div>
	</section>
}
