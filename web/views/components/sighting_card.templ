package components

import (
	"cmp"
	"fmt"
	"slices"
	"strings"

	"workshop/pkg/domain/sighting"
	"workshop/pkg/domain/species"
)

templ SightingCard(s sighting.Sighting) {
	<article class={ "specimen-plate", "polaroid", tones(s) } data-light={ Light(s) }>
		<a class="specimen-plate__link" href={ templ.URL(SightingURL(s)) }>
			<div class="specimen-plate__margin">
				<span class="specimen-plate__id">REF // { fmt.Sprintf("%03d", s.GBIFKey%1000) }</span>
				<span class="specimen-plate__coords">{ ShortCoords(s) }</span>
				<span class="specimen-plate__country">{ Postmark(s) }</span>
			</div>

			<div class="specimen-plate__photo polaroid__photo">
				if c, ok := cover(s); ok {
					<img src={ sized(c.URL, "medium") } alt={ photoAlt(s, c) } loading="lazy" decoding="async"/>
				} else {
					<div class="polaroid__empty" aria-hidden="true">
						<span>[ NO PHOTOGRAPHIC NEGATIVE ]</span>
					</div>
				}
				<div class="specimen-plate__reticle" aria-hidden="true"></div>
				<div class="specimen-plate__strip">
					<span class="specimen-plate__solar">
						<i class="specimen-plate__solar-mark"></i>
						{ Light(s) }
					</span>
					if s.Weather.Condition.Code != 0 {
						<span class="specimen-plate__wx">
							@Weather(s.Weather)
						</span>
					}
				</div>
			</div>

			<div class="specimen-plate__caption polaroid__chin">
				<div class="specimen-plate__title-line">
					<h3 class="specimen-plate__title polaroid__title">{ displayName(s.Species) }</h3>
					if s.IndividualCount != nil {
						<span class="specimen-plate__count">[{ individuals(*s.IndividualCount) }]</span>
					}
				</div>
				if s.Species.ScientificName != "" {
					<p class="specimen-plate__latin polaroid__latin">{ s.Species.ScientificName }</p>
				}
				<div class="specimen-plate__foot polaroid__notes">
					<span class="polaroid__place">{ place(s.Location) }</span>
					<span class="polaroid__dot">—</span>
					<span class="polaroid__date">{ when(s) }</span>
				</div>
				<div class="specimen-plate__credit polaroid__footer">
					if s.RecordedBy != "" {
						<span class="polaroid__observer">OBS. { s.RecordedBy }</span>
					} else {
						<span class="polaroid__observer">OBS. GBIF SURVEY</span>
					}
					<span class="specimen-plate__inspect">DOSSIER ↗</span>
				</div>
			</div>
		</a>
	</article>
}

// displayName prefers the name a reader would recognise, falling back
// through the taxonomy as GBIF records thin out.
func displayName(sp species.Species) string {
	return cmp.Or(sp.VernacularName, sp.CanonicalName, sp.ScientificName, "Unknown species")
}

// place joins whichever parts of the location GBIF supplied.
func place(l sighting.Location) string {
	parts := slices.DeleteFunc(
		[]string{l.Locality, l.StateProvince, l.Country},
		func(s string) bool { return s == "" },
	)
	return cmp.Or(strings.Join(parts, ", "), "Location unknown")
}

// individuals renders how many animals were seen in a single sighting.
func individuals(n int) string {
	if n == 1 {
		return "1 IND."
	}
	return fmt.Sprintf("%d IND.", n)
}
