package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Stats(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Stats",
		Description: "The sightings counted: animals, countries, years, light and weather.",
		Page:        "stats",
		Class:       "page-stats",
	}) {
		<section class="page-head container">
			<p class="eyebrow">By the numbers</p>
			<h1 class="display">The wild, counted</h1>
			if sum.Sightings > 0 {
				<p class="lede">{ strconv.Itoa(sum.Sightings) } sightings between { strconv.Itoa(sum.Earliest.Year()) } and { strconv.Itoa(sum.Latest.Year()) }, from { strconv.Itoa(sum.Recorders) } people who stopped to look.</p>
			}
		</section>
		if sum.Sightings == 0 {
			<p class="container empty">Nothing to count yet: no sightings have been ingested.</p>
		} else {
			<div class="container">
				<dl class="bignums reveal">
					<div>
						<dt>Sightings</dt>
						<dd>{ strconv.Itoa(sum.Sightings) }</dd>
					</div>
					<div>
						<dt>Species</dt>
						<dd>{ strconv.Itoa(sum.Species) }</dd>
					</div>
					<div>
						<dt>Countries</dt>
						<dd>{ strconv.Itoa(sum.Countries) }</dd>
					</div>
					<div>
						<dt>Photos</dt>
						<dd>{ strconv.Itoa(sum.Media) }</dd>
					</div>
					<div>
						<dt>Animals counted</dt>
						<dd>{ strconv.Itoa(sum.Individuals) }</dd>
					</div>
					<div>
						<dt>Observers</dt>
						<dd>{ strconv.Itoa(sum.Recorders) }</dd>
					</div>
				</dl>
				<section class="panel panel--wide reveal" aria-labelledby="years-title">
					<h2 id="years-title" class="panel__title">Sightings per year</h2>
					@components.Sparkline(byYear, sum)
					<p class="panel__axis"><span>{ strconv.Itoa(sum.Earliest.Year()) }</span><span>{ strconv.Itoa(sum.Latest.Year()) }</span></p>
				</section>
				<div class="charts-grid">
					<section class="panel reveal" aria-labelledby="animals-title">
						<h2 id="animals-title" class="panel__title">Most seen animals</h2>
						@components.Bars(sighting.Top(sighting.CountBy(sightings, components.Animal), 8))
					</section>
					<section class="panel reveal" aria-labelledby="countries-title">
						<h2 id="countries-title" class="panel__title">Busiest countries</h2>
						@components.Bars(sighting.Top(sighting.CountBy(sightings, components.Country), 8))
					</section>
					<section class="panel panel--light reveal" aria-labelledby="light-title">
						<h2 id="light-title" class="panel__title">What light they were seen in</h2>
						@components.Bars(components.LightTally(sightings))
					</section>
					<section class="panel reveal" aria-labelledby="sky-title">
						<h2 id="sky-title" class="panel__title">Under what sky</h2>
						@components.Bars(components.SkyTally(sightings))
					</section>
					<section class="panel reveal" aria-labelledby="observers-title">
						<h2 id="observers-title" class="panel__title">Keenest observers</h2>
						@components.Bars(sighting.Top(sighting.CountBy(sightings, components.Recorder), 6))
					</section>
				</div>
			</div>
		}
	}
}
