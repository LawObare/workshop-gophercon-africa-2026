package layout

import "workshop/web/views/components"

type BaseProps struct {
	Title       string
	Description string
	Page        string // Which nav link is the current page: "home", "gallery" or "spot".
	Class       string // Classes on <body>, such as the tint of the sighting shown.
	Map         bool   // Load Leaflet for a components.Map.
	Three       bool   // Load three.js for a components.ThreeScene.
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB" data-sky="day">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<meta name="theme-color" content="#F3ead8"/>
			<title>{ title(props.Title) }</title>
			<meta name="description" content={ description(props.Description) }/>
			<script>
				document.documentElement.classList.add('js');
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,wght@0,9..144,50,300..800;1,9..144,50,300..600&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"/>
			if props.Map {
				<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw==" crossorigin="anonymous" referrerpolicy="no-referrer"/>
				<link rel="stylesheet" href="/assets/css/map.css"/>
			}
			if props.Three {
				<link rel="stylesheet" href="/assets/css/threejs.css"/>
			}
			<link rel="stylesheet" href="/assets/css/weather.css"/>
			<link rel="stylesheet" href="/assets/css/filter.css"/>
			<link rel="stylesheet" href="/assets/css/lightbox.css"/>
			<link rel="stylesheet" href="/assets/css/reveal.css"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<link rel="stylesheet" href="/assets/css/playful.css"/>
			<link rel="stylesheet" href="/assets/css/transitions.css"/>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
			<script src="/assets/js/reveal.js" defer></script>
		</head>
		<body class={ props.Class }>
			<!-- GPU-Composited 4-Minute Automated Savanna Sky Backdrop -->
			<div class="savanna-sky" aria-hidden="true" data-savanna-sky>
				<!-- 1. Bright Red Dawn -->
				<div class="savanna-sky__layer savanna-sky__layer--dawn" data-sky-layer="dawn">
					<div class="savanna-sky__sun savanna-sky__sun--dawn"></div>
				</div>

				<!-- 2. Blue Savanna Day Sky + Drifting Cloud Formations -->
				<div class="savanna-sky__layer savanna-sky__layer--day" data-sky-layer="day">
					<div class="savanna-sky__sun savanna-sky__sun--day"></div>
					<div class="savanna-sky__clouds savanna-sky__clouds--near">
						<svg viewBox="0 0 1600 320" preserveAspectRatio="none">
							<g fill="rgba(255,255,255,0.72)">
								<path d="M120 150 Q145 110 190 118 Q225 85 275 108 Q320 98 345 132 Q380 135 375 162 L105 162 Z"/>
								<path d="M620 115 Q655 75 710 88 Q755 55 820 82 Q870 75 895 112 Q930 118 922 142 L600 142 Z" opacity="0.85"/>
								<path d="M1180 165 Q1210 128 1260 136 Q1300 105 1355 128 Q1395 122 1418 156 L1165 156 Z" opacity="0.75"/>
							</g>
						</svg>
					</div>
					<div class="savanna-sky__clouds savanna-sky__clouds--far">
						<svg viewBox="0 0 1600 320" preserveAspectRatio="none">
							<g fill="rgba(255,255,255,0.48)">
								<path d="M340 205 Q375 172 425 182 Q465 158 515 178 Q550 175 568 205 Z"/>
								<path d="M910 190 Q950 155 1005 168 Q1050 142 1105 166 Q1140 162 1160 190 Z"/>
							</g>
						</svg>
					</div>
				</div>

				<!-- 3. Bright Red Dusk -->
				<div class="savanna-sky__layer savanna-sky__layer--dusk" data-sky-layer="dusk">
					<div class="savanna-sky__sun savanna-sky__sun--dusk"></div>
				</div>

				<!-- 4. Starry Savanna Night (with dedicated starfield & Milky Way canvas) -->
				<div class="savanna-sky__layer savanna-sky__layer--night" data-sky-layer="night">
					<canvas class="savanna-sky__starcanvas" data-star-canvas></canvas>
				</div>

				<!-- Persistent Savanna Acacia & Kopje Horizon Silhouette -->
				<div class="savanna-sky__horizon">
					<svg viewBox="0 0 1440 120" preserveAspectRatio="none">
						<path d="M0 120 L0 88 L140 76 L310 86 L520 68 L740 84 L980 66 L1230 82 L1440 72 L1440 120 Z" fill="currentColor" opacity="0.28"/>
						<path d="M0 120 L0 98 L260 90 L620 98 L1040 88 L1440 96 L1440 120 Z" fill="currentColor" opacity="0.65"/>
						<!-- Umbrella Thorn Acacia (Left) -->
						<g transform="translate(110, 32)" fill="currentColor" opacity="0.72">
							<path d="M36 66 L38 38 L20 26 L25 26 L38 35 L40 23 L43 23 L41 35 L54 25 L59 25 L42 38 L44 66 Z"/>
							<ellipse cx="40" cy="21" rx="34" ry="4.5"/>
							<ellipse cx="24" cy="16" rx="18" ry="3.2"/>
							<ellipse cx="56" cy="17" rx="16" ry="3"/>
						</g>
						<!-- Umbrella Thorn Acacia (Right) -->
						<g transform="translate(1240, 40)" fill="currentColor" opacity="0.72">
							<path d="M28 58 L29 34 L16 24 L20 24 L29 31 L31 21 L33 21 L31 31 L42 23 L46 23 L32 34 L33 58 Z"/>
							<ellipse cx="31" cy="19" rx="26" ry="3.8"/>
							<ellipse cx="19" cy="15" rx="13" ry="2.6"/>
							<ellipse cx="43" cy="15.5" rx="12" ry="2.5"/>
						</g>
					</svg>
				</div>
			</div>

			@components.WeatherIcons()
			@components.MonkeyVine()
			<a class="skip" href="#main">Skip to content</a>
			<div class="scroll-sentinel" data-sentinel aria-hidden="true"></div>

			<!-- Topographic Meridian Ticker -->
			<div class="meridian-bar" role="region" aria-label="Expedition coordinates and automated 4-minute savanna sky cycle">
				<div class="meridian-bar__left">
					<span class="meridian-bar__coord">01°17′S 36°49′E · NAIROBI MERIDIAN</span>
					<span class="meridian-bar__sep">/</span>
					<span class="meridian-bar__bday">16 OCT · HAPPY BIRTHDAY CHIEF RANGER EXPEDITION EDITION</span>
				</div>
				<div class="meridian-bar__right">
					<div class="sky-cycle-hud" title="Automated 4-minute savanna sky cycle (click any phase to preview)">
						<span class="sky-cycle-hud__orb" data-sky-orb></span>
						<span class="sky-cycle-hud__clock" data-sky-clock>06:00 EAT</span>
						<span class="sky-cycle-hud__phase" data-sky-phase>ALFAJIRI // CRIMSON DAWN</span>
						<span class="sky-cycle-hud__track" aria-hidden="true">
							<span class="sky-cycle-hud__fill" data-sky-progress></span>
						</span>
						<div class="sky-cycle-hud__jumps" role="group" aria-label="Preview savanna sky period">
							<button type="button" class="sky-cycle-hud__jump" data-sky-jump="dawn">Dawn</button>
							<button type="button" class="sky-cycle-hud__jump" data-sky-jump="day">Day</button>
							<button type="button" class="sky-cycle-hud__jump" data-sky-jump="dusk">Dusk</button>
							<button type="button" class="sky-cycle-hud__jump" data-sky-jump="night">Night</button>
						</div>
					</div>
					<button type="button" class="camp-radio" data-sound-toggle aria-pressed="false">
						<span class="camp-radio__bars" aria-hidden="true">
							<span></span><span></span><span></span>
						</span>
						<span data-sound-label>HZ RADIO</span>
					</button>
				</div>
			</div>

			<header class="site-header" data-header>
				<a class="logo" href="/">
					<span class="logo__mark" aria-hidden="true">
						<svg viewBox="0 0 44 28" width="44" height="28">
							<circle cx="29" cy="15" r="10" fill="var(--accent)"/>
							<path d="M2 24 L42 24" stroke="currentColor" stroke-width="1.5"/>
							<path d="M18 24 L19 13 L10 8 L13 8 L19.5 11.5 L20.5 7 L22.5 7 L21.5 11.5 L28 7.5 L31 7.5 L21 13.5 L21.5 24 Z" fill="currentColor"/>
							<ellipse cx="20" cy="6.5" rx="14" ry="2.2" fill="currentColor"/>
							<ellipse cx="13" cy="4.2" rx="7" ry="1.6" fill="currentColor"/>
							<ellipse cx="27" cy="4.5" rx="6.5" ry="1.5" fill="currentColor"/>
						</svg>
					</span>
					<div class="logo__text">
						<span class="logo__name">JAMBO</span>
						<span class="logo__sub">East African Field Monograph</span>
					</div>
				</a>

				<nav class="site-nav" aria-label="Main">
					<ul>
						<li><a href="/" aria-current?={ props.Page == "home" }><span>I.</span> Field Index</a></li>
						<li><a href="/#sightings"><span>II.</span> Specimen Plates</a></li>
						<li><a href="/gallery" aria-current?={ props.Page == "gallery" }><span>III.</span> Contact Sheet</a></li>
						<li><a href="/spot" aria-current?={ props.Page == "spot" }><span>IV.</span> Bushcraft &amp; Track</a></li>
					</ul>
				</nav>

				<button type="button" class="passport-trigger press" data-passport-open title="Open Field Stamp Book">
					<span class="passport-trigger__stamp">STAMP BOOK</span>
					<strong class="passport-trigger__count" data-passport-badge>0/6</strong>
				</button>
			</header>

			<main id="main" tabindex="-1">
				{ children... }
			</main>

			<footer class="site-footer">
				<div class="savanna-horizon" aria-hidden="true">
					<svg viewBox="0 0 1440 84" preserveAspectRatio="none">
						<path d="M0 84 L0 64 L180 54 L390 66 L640 48 L920 62 L1190 52 L1440 64 L1440 84 Z" fill="currentColor" opacity="0.14"></path>
						<path d="M0 84 L0 74 L320 64 L780 72 L1140 62 L1440 72 L1440 84 Z" fill="currentColor"></path>
						<g transform="translate(220, 22)">
							<path d="M28 50 L29 30 L18 22 L22 22 L29 28 L31 20 L33 20 L31 28 L40 21 L44 21 L32 30 L33 50 Z" fill="currentColor"></path>
							<ellipse cx="31" cy="19" rx="24" ry="3.5" fill="currentColor"></ellipse>
							<ellipse cx="20" cy="15.5" rx="12" ry="2.6" fill="currentColor"></ellipse>
							<ellipse cx="42" cy="16" rx="11" ry="2.4" fill="currentColor"></ellipse>
						</g>
						<g transform="translate(1120, 26)">
							<path d="M12 46 L14 28 L18 28 L26 8 L30 7 L29 10 L22 28 L28 31 L27 46 L25 46 L25 34 L16 33 L14 46 Z" fill="currentColor"></path>
						</g>
					</svg>
				</div>
				<div class="site-footer__inner">
					<div class="site-footer__col">
						<p class="site-footer__title">JAMBO · FIELD ARCHIVE</p>
						<p class="site-footer__note">
							Compiled from <a href="https://www.gbif.org" rel="noopener">GBIF</a> biological occurrences and <a href="https://open-meteo.com" rel="noopener">Open-Meteo</a> atmospheric archives. All photographic plates remain the property of the observing naturalists.
						</p>
					</div>
					<div class="site-footer__col">
						@components.SnorkellingHippo()
					</div>
					<nav aria-label="Footer">
						<ul>
							<li><a href="/">Field Index</a></li>
							<li><a href="/#sightings">Specimens</a></li>
							<li><a href="/gallery">Contact Sheet</a></li>
							<li><a href="/spot">Bushcraft</a></li>
						</ul>
					</nav>
				</div>
			</footer>
			@components.SafariPassport()
			@components.Lightbox()
			if props.Map {
				<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
				<script src="/assets/js/map.js" defer></script>
			}
			<script src="/assets/js/filter.js" defer></script>
			<script src="/assets/js/lightbox.js" defer></script>
			<script src="/assets/js/playful.js" defer></script>
			<script src="/assets/js/app.js" defer></script>
		</body>
	</html>
}
