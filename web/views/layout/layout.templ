package layout

import "workshop/web/views/components"

type BaseProps struct {
	Title       string
	Description string
	Page        string // Which nav link is the current page: "home", "gallery" or "stats".
	Class       string // Classes on <body>, such as the tint of the sighting shown.
	Map         bool   // Load Leaflet for a components.Map.
	Three       bool   // Load three.js for a components.ThreeScene.
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<meta name="theme-color" content="#1C1110"/>
			<meta name="color-scheme" content="dark"/>
			<title>{ title(props.Title) }</title>
			<meta name="description" content={ description(props.Description) }/>
			<script>document.documentElement.classList.add('js')</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=Nunito+Sans:ital,opsz,wght@0,6..12,300..800;1,6..12,400&display=swap"/>
			if props.Map {
				<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw==" crossorigin="anonymous" referrerpolicy="no-referrer"/>
				<link rel="stylesheet" href="/assets/css/map.css"/>
			}
			if props.Three {
				<script type="importmap">
					{
						"imports": {
							"three": "https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js",
							"three/addons/": "https://cdn.jsdelivr.net/npm/three@0.186.1/examples/jsm/"
						}
					}
				</script>
				<link rel="stylesheet" href="/assets/css/threejs.css"/>
			}
			<link rel="stylesheet" href="/assets/css/weather.css"/>
			<link rel="stylesheet" href="/assets/css/charts.css"/>
			<link rel="stylesheet" href="/assets/css/filter.css"/>
			<link rel="stylesheet" href="/assets/css/lightbox.css"/>
			<link rel="stylesheet" href="/assets/css/reveal.css"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<link rel="stylesheet" href="/assets/css/transitions.css"/>
			<script src="/assets/js/reveal.js" defer></script>
		</head>
		<body class={ props.Class }>
			@components.WeatherIcons()
			<a class="skip" href="#main">Skip to content</a>
			<div class="scroll-sentinel" data-sentinel aria-hidden="true"></div>
			<header class="site-header" data-header>
				<a class="logo press" href="/">
					<img src="/assets/images/logo.svg" alt="" width="36" height="36"/>
					<span class="logo__name">Golden Hour</span>
				</a>
				<nav class="site-nav" aria-label="Main">
					<ul>
						<li><a href="/" aria-current?={ props.Page == "home" }>Home</a></li>
						<li><a href="/#sightings">Sightings</a></li>
						<li><a href="/gallery" aria-current?={ props.Page == "gallery" }>Gallery</a></li>
						<li><a href="/stats" aria-current?={ props.Page == "stats" }>Stats</a></li>
					</ul>
				</nav>
			</header>
			<main id="main" tabindex="-1">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="site-footer__inner">
					<a class="logo" href="/">
						<img src="/assets/images/logo.svg" alt="" width="32" height="32"/>
						<span class="logo__name">Golden Hour</span>
					</a>
					<p class="site-footer__note">
						Sightings from <a href="https://www.gbif.org" rel="noopener">GBIF</a>,
						weather from <a href="https://open-meteo.com" rel="noopener">Open-Meteo</a>.
						Every photo belongs to the person who took it.
					</p>
					<nav aria-label="Footer">
						<ul>
							<li><a href="/">Home</a></li>
							<li><a href="/gallery">Gallery</a></li>
							<li><a href="/stats">Stats</a></li>
						</ul>
					</nav>
				</div>
			</footer>
			@components.Lightbox()
			if props.Map {
				<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
				<script src="/assets/js/map.js" defer></script>
			}
			<script src="/assets/js/filter.js" defer></script>
			<script src="/assets/js/lightbox.js" defer></script>
			<script src="/assets/js/app.js" defer></script>
		</body>
	</html>
}
